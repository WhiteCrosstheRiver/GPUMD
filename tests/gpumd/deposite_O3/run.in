replicate 1 1 3

potential   ./nep.txt

time_step   1

fix 1


deposit O3.xyz  number 10 velocity -0.0002 0.0002  -0.0001 -0.0001 -0.0002 0.0002 position 0 272.185 210 230 0 26.945

dump_thermo 1000
