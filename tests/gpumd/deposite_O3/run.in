replicate 1 1 3

potential   ./nep.txt

time_step   1

fix 1


deposit ozone particle molecule O3.xyz
deposit ozone placement random
deposit ozone region plane normal 0 0 1 bounds 0 272.185 210 230 height 20
deposit ozone velocity beam speed 1.9645381223534e-5 units angstrom/fs direction 0 0 -1
deposit ozone seed 1
deposit ozone emit number 10

dump_thermo 1000
dump_exyz   1 1 1 1

# use a large tau_T to mimic NPH
ensemble    nvt_ber 400 400 10
run         1

