replicate       5 5 5
potential       ../../../../potentials/nep/C_2022_NEP3.txt
velocity        300
time_step       1.0
ensemble        nve
variable rx equal random(0,lx,12345)
variable ry equal random(0,ly,12345)
variable cx equal ${rx}
variable cy equal ${ry}
deposit gaussian atom C number 1 origin ${cx} ${cy} sigma 1.0 direction axis -z surface local radius 5.0 gap 2.0 spread gaussian 5 velocity constant 0.001 seed 1
dump_xyz -1 0 1 after.xyz
run 1
