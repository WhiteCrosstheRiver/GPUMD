replicate       5 5 5
potential       ../../../../potentials/nep/C_2022_NEP3.txt
velocity        300
time_step       1.0
ensemble        nve
variable rx equal random(0,lx,7)
variable ry equal random(0,ly,7)
for p range 1 5
    variable cx equal ${rx}
    variable cy equal ${ry}
    deposit carbon particle atom C
    deposit carbon placement gaussian center ${cx} ${cy} sigma 1.0
    deposit carbon region surface normal 0 0 1 bounds -1000000 1000000 -1000000 1000000 height local radius 5.0 gap 2.0 scope all
    deposit carbon velocity beam speed 9.82269061176699e-5 units angstrom/fs direction 0 0 -1 spread 5
    deposit carbon seed 1
    deposit carbon emit number 1
    run 1
end
dump_xyz -1 0 1 after.xyz
run 1
