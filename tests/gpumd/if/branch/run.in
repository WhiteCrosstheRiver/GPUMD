replicate       5 5 5
potential       ../../../../potentials/nep/C_2022_NEP3.txt
velocity        300
time_step       1.0
ensemble        nve

if 1 < 2
    dump_xyz -1 0 1 then.xyz
else
    dump_xyz -1 0 1 else.xyz
end
run 1

variable u equal 0.2
if ${u} < 0.5
    dump_xyz -1 0 1 rand_lo.xyz
else
    dump_xyz -1 0 1 rand_hi.xyz
end
run 1

for p range 1 3
    variable cx equal random(0,lx,99)
    variable cy equal random(0,ly,99)
    if 1 == 1
        deposit then_carbon particle atom C
        deposit then_carbon placement gaussian center ${cx} ${cy} sigma 1.0
        deposit then_carbon region surface normal 0 0 1 bounds -1000000 1000000 -1000000 1000000 height local radius 5.0 gap 2.0 scope all
        deposit then_carbon velocity beam speed 9.82269061176699e-5 units angstrom/fs direction 0 0 -1 spread 5
        deposit then_carbon seed 1
        deposit then_carbon emit number 1
    else
        deposit else_carbon particle atom C
        deposit else_carbon placement gaussian center 8.8 8.8 sigma 1.0
        deposit else_carbon region surface normal 0 0 1 bounds -1000000 1000000 -1000000 1000000 height local radius 5.0 gap 2.0 scope all
        deposit else_carbon velocity beam speed 9.82269061176699e-5 units angstrom/fs direction 0 0 -1 spread 5
        deposit else_carbon seed 1
        deposit else_carbon emit number 1
    end
    run 1
end
dump_xyz -1 0 1 after.xyz
run 1
