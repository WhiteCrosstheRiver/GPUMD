replicate       5 5 5
potential       ../../../../potentials/nep/C_2022_NEP3.txt
velocity        300
time_step       1.0
ensemble        nve

if 1 < 2
    dump_xyz -1 0 1 then.xyz
else
    dump_xyz -1 0 1 else.xyz
end
run 1

variable u equal 0.2
if ${u} < 0.5
    dump_xyz -1 0 1 rand_lo.xyz
else
    dump_xyz -1 0 1 rand_hi.xyz
end
run 1

for p range 1 3
    variable cx equal random(0,lx,99)
    variable cy equal random(0,ly,99)
    if 1 == 1
        deposit gaussian atom C number 1 origin ${cx} ${cy} sigma 1.0 direction axis -z surface local radius 5.0 gap 2.0 spread gaussian 5 velocity constant 0.001 seed 1
    else
        deposit gaussian atom C number 1 origin 8.8 8.8 sigma 1.0 direction axis -z surface local radius 5.0 gap 2.0 spread gaussian 5 velocity constant 0.001 seed 1
    end
    run 1
end
dump_xyz -1 0 1 after.xyz
run 1
