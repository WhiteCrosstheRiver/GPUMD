replicate       5 5 5
potential       ../../../../potentials/nep/C_2022_NEP3.txt
velocity        300
time_step       1.0
ensemble        nve

for i range 1 3
    deposit point molecule C.xyz origin 8.8 8.8 direction axis -z surface fixed 16 velocity constant 0.001
    dump_thermo 1
    run 1
end

delete cubic 8.7 8.9 8.7 8.9 15.9 16.1
dump_thermo 1
run 1
