replicate 1 1 3

potential   ./nep.txt

time_step   1

fix 1

for cycle range 1 2

    deposit random molecule O3.xyz number 10 region 0 272.185 210 230 direction axis -z surface fixed 20 velocity constant 0.0002 seed 1

    dump_thermo 1000
    dump_exyz   1 1 1 1

    # use a large tau_T to mimic NPH
    ensemble    nvt_ber 400 400 10
    run         1

end
