replicate       5 5 5
potential       ../../../../potentials/nep/C_2022_NEP3.txt
velocity        300
time_step       1.0
ensemble        nve

for i range 1 3
    deposit gaussian atom C number 1 origin 8.8 8.8 sigma 1.0 direction axis -z surface local radius 5.0 gap 2.0 spread gaussian 5 velocity constant 0.001 seed 1
    dump_thermo 1
    run 1
end
